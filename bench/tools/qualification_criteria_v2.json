{
  "version": 2,
  "description": "Acceptance criteria v2: v1 UNCHANGED plus the issue #2 phase-2 scenarios (S3R-1, S3R-2, S3R-3, R4). Written BEFORE any run of these scenarios; pin its sha256 with --criteria-sha256. v1 (qualification_criteria.json, sha256 2dfc47e2...760760c) stays valid and is never edited.",
  "repeat_min": 3,
  "common": {
    "required_files": [
      "report.json",
      "run.json",
      "provenance.json",
      "manifest.json",
      "before.json",
      "after.json",
      "cleanup.json",
      "events.jsonl",
      "requests.jsonl",
      "recipe.py",
      "verdicts.jsonl"
    ],
    "hardware_grade_provenance": true
  },
  "scenarios": {
    "Q1": {
      "allowed_commands": [
        "flash.read",
        "flash.write",
        "partitions"
      ],
      "extra_files": [],
      "continuity": "unchanged",
      "operator_requests": {
        "grant": 1,
        "revoke": 1,
        "other": 0
      }
    },
    "Q2a": {
      "expect_trigger_ops_min": 2,
      "refusal": [
