{
    "name": "IOBEWI Rust ESP and hardware bench",
    "build": {
        "dockerfile": "../docker/Dockerfile",
        "context": ".."
    },
    "workspaceFolder": "/workspace",
    "mounts": [
        "source=${localWorkspaceFolder},target=/workspace,type=bind",
        "source=.claude,target=/root/.claude,type=bind",
        "source=iobewi-bench-state,target=/root/.local/state/iobewi-bench,type=volume"
    ],
    "forwardPorts": [
        8080
    ],
    "portsAttributes": {
        "8080": {
            "label": "IOBEWI hardware bench",
            "onAutoForward": "notify"
        }
    },
    "containerEnv": {
        "RUST_BACKTRACE": "1",
        "BENCH_STATE_DIR": "/root/.local/state/iobewi-bench"
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "rust-lang.rust-analyzer",
                "tamasfe.even-better-toml"
            ],
            "settings": {
                "rust-analyzer.check.command": "check",
                "git.autoRepositoryDetection": "subFolders",
                "git.repositoryScanMaxDepth": 2,
                "git.detectSubmodules": true
            }
        }
    },
    "postCreateCommand": "bash -lc '. /opt/esp/export-esp.sh && rustc --version && cargo --version && espup --version && espflash --version && esp-generate --version && python -m pip install -e \"/workspace/bench/python[pytest]\" && cd /workspace/bench && npm ci --ignore-scripts && npx playwright install --with-deps chromium'",
    "postStartCommand": "python --version && node --version",
    "remoteUser": "root"
}
