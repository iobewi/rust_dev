{
    "name": "IOBEWI Rust ESP and hardware bench",
    "build": {
        "dockerfile": "../docker/Dockerfile",
        "context": ".."
    },
    "workspaceFolder": "/workspace",
    "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
    "mounts": [
        "source=iobewi-claude-state,target=/root/.claude,type=volume",
        "source=iobewi-bench-state,target=/root/.local/state/iobewi-bench,type=volume"
    ],
    "forwardPorts": [
        8080
    ],
    "portsAttributes": {
        "8080": {
            "label": "IOBEWI hardware bench",
            "onAutoForward": "notify"
        }
    },
    "containerEnv": {
        "RUST_BACKTRACE": "1",
        "BENCH_STATE_DIR": "/root/.local/state/iobewi-bench"
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "rust-lang.rust-analyzer",
                "tamasfe.even-better-toml"
            ],
            "settings": {
                "rust-analyzer.check.command": "check",
                "git.autoRepositoryDetection": "subFolders",
                "git.repositoryScanMaxDepth": 2,
                "git.detectSubmodules": true
            }
        }
    },
    "postCreateCommand": ["bash", "/workspace/.devcontainer/post-create.sh"],
    "postStartCommand": ["bash", "-lc", ". /opt/esp/export-esp.sh && python --version && node --version && rustc --version && rustc +esp --version"],
    "remoteUser": "root"
}
